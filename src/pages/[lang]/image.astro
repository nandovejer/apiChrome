---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import Output from "../../components/Output.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { m } = i18n(Astro.url);
const t = m.image;
---

<AppLayout slug="image">
  <DemoShell slug="image">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="file">{t.image}</label>
        <input class="luz-input" id="file" type="file" accept="image/*" required />
      </div>
      <figure class="luz-figure" data-preview hidden>
        <img class="preview" id="preview" alt={t.previewAlt} />
      </figure>
      <div class="luz-field">
        <label class="luz-field__label" for="question">{t.question}</label>
        <input class="luz-input" id="question" list="questions" autocomplete="off" />
        <datalist id="questions"></datalist>
      </div>
      <RunBar label={t.analyze} submit />
    </form>
    <Output id="out" label={t.answer} placeholder={m.common.streamPlaceholder} />
    <p class="meta">{t.privacy}</p>
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/image";
</script>
