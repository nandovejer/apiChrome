---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { m } = i18n(Astro.url);
const t = m.json;
---

<AppLayout slug="json">
  <DemoShell slug="json">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="description">{t.describe}</label>
        <textarea class="luz-input luz-input--textarea" id="description" rows="3" required></textarea>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="preset">{t.preset}</label>
        <select class="luz-select" id="preset"></select>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="schema">{t.schema}</label>
        <textarea class="luz-input luz-input--textarea" id="schema" rows="10" spellcheck="false" aria-describedby="schema-help"></textarea>
        <div class="luz-field__helper" id="schema-help">{t.schemaHelp}</div>
      </div>
      <RunBar label={t.generate} submit />
    </form>
    <section class="o-stack" data-json-panel hidden>
      <div class="o-row">
        <h2>{t.result}</h2>
        <button class="luz-copy-btn" type="button" data-copy-from="json-out" aria-label={m.common.copyJson}>{m.common.copy}</button>
      </div>
      <pre class="luz-code-block" data-lang="json" tabindex="0" role="region" aria-label={t.generatedAria}><code id="json-out"></code></pre>
      <p class="meta" data-meta hidden></p>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/json";
</script>
