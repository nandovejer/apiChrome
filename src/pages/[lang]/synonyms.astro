---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { m } = i18n(Astro.url);
const t = m.synonyms;
---

<AppLayout slug="synonyms">
  <DemoShell slug="synonyms">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="word">{t.word}</label>
        <input class="luz-input" id="word" required autocomplete="off" />
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="count">{t.howMany} <output class="luz-output" id="count-out" for="count">6</output></label>
        <input class="luz-input" id="count" type="range" min="3" max="12" value="6" data-output="count-out" />
      </div>
      <RunBar label={t.find} submit />
    </form>
    <section class="o-stack" data-results hidden>
      <h2>{t.heading}</h2>
      <div class="luz-table-wrap" role="region" aria-label={t.heading} tabindex="0">
        <table class="luz-table">
          <thead><tr><th scope="col">{t.colWord}</th><th scope="col">{t.colDiff}</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <p class="meta" data-meta hidden></p>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/synonyms";
</script>
