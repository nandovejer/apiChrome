---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import Output from "../../components/Output.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { m } = i18n(Astro.url);
const t = m.recipes;
const fields: [string, boolean][] = [["emails", true], ["phones", true], ["names", true], ["urls", false], ["dates", false]];
---

<AppLayout slug="recipes">
  <DemoShell slug="recipes">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="recipe">{t.recipe}</label>
        <select class="luz-select" id="recipe" aria-describedby="recipe-help">
          {(Object.keys(t.recipes) as (keyof typeof t.recipes)[]).map((key) => <option value={key}>{t.recipes[key]}</option>)}
        </select>
        <div class="luz-field__helper" id="recipe-help"></div>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="input">{t.text}</label>
        <textarea class="luz-input luz-input--textarea" id="input" rows="6" required></textarea>
      </div>
      <div class="luz-field" data-for="classify">
        <label class="luz-field__label" for="labels">{t.categories}</label>
        <input class="luz-input" id="labels" value={t.defaultCategories} />
      </div>
      <fieldset class="luz-fieldset" data-for="extract" hidden>
        <legend>{t.fields}</legend>
        <div class="luz-check-group">
          {
            fields.map(([key, checked]) => (
              <div class="luz-check-item">
                <input type="checkbox" id={`f-${key}`} value={key} checked={checked} />
                <label for={`f-${key}`}>{t.fieldNames[key as keyof typeof t.fieldNames]}</label>
              </div>
            ))
          }
        </div>
      </fieldset>
      <div class="luz-field" data-for="tags questions" hidden>
        <label class="luz-field__label" for="count">{t.howMany} <output class="luz-output" id="count-out" for="count">5</output></label>
        <input class="luz-input" id="count" type="range" min="1" max="10" value="5" data-output="count-out" />
      </div>
      <RunBar label={t.run} submit />
    </form>
    <p class="luz-alert luz-alert--info" data-verdict hidden role="status"></p>
    <Output id="text-out" label={t.result} placeholder={m.common.resultPlaceholder} meta={false} />
    <p class="meta" data-meta hidden></p>
    <section class="o-stack" data-json-panel hidden>
      <div class="o-row">
        <h2>{t.structured}</h2>
        <button class="luz-copy-btn" type="button" data-copy-from="json-out" aria-label={m.common.copyJson}>{m.common.copy}</button>
      </div>
      <pre class="luz-code-block" data-lang="json" tabindex="0" role="region" aria-label={t.structured}><code id="json-out"></code></pre>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/recipes";
</script>
