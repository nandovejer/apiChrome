---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import Output from "../../components/Output.astro";
import LanguageSelect from "../../components/LanguageSelect.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { lang, m } = i18n(Astro.url);
const t = m.translate;
---

<AppLayout slug="translate">
  <DemoShell slug="translate">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="input">{t.text}</label>
        <textarea class="luz-input luz-input--textarea" id="input" name="input" rows="5" required placeholder={t.placeholder}></textarea>
        <div class="luz-field__helper" id="detected" aria-live="polite"></div>
      </div>
      <div class="o-grid o-grid--2">
        <LanguageSelect id="source" label={t.source} value="auto" auto />
        <LanguageSelect id="target" label={t.target} value={lang === "es" ? "en" : "es"} />
      </div>
      <RunBar label={t.run} submit>
        <button class="luz-btn luz-btn--ghost" type="button" data-swap>{t.swap}</button>
      </RunBar>
    </form>
    <Output id="out" label={t.translation} placeholder={t.waiting} />
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/translate";
</script>
