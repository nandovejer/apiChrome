---
import AppLayout from "../../layouts/AppLayout.astro";
import DemoShell from "../../components/DemoShell.astro";
import RunBar from "../../components/RunBar.astro";
import { getStaticPaths } from "../../i18n";
import { i18n } from "../../i18n/server";

export { getStaticPaths };
const { m } = i18n(Astro.url);
const t = m.assistant;
const k = m.common.corrections;
---

<AppLayout slug="assistant">
  <DemoShell slug="assistant">
    <div class="o-stack">
      <div class="luz-field">
        <label class="luz-field__label" for="editor">{t.text}</label>
        <textarea class="luz-input luz-input--textarea" id="editor" rows="9" placeholder={t.placeholder}></textarea>
      </div>
      <RunBar label={t.correct} secondary>
        <button class="luz-btn luz-btn--outline" type="button" data-act="formal">{t.formal}</button>
        <button class="luz-btn luz-btn--outline" type="button" data-act="friendly">{t.friendly}</button>
        <button class="luz-btn luz-btn--outline" type="button" data-act="concise">{t.concise}</button>
        <button class="luz-btn luz-btn--outline" type="button" data-act="simplify">{t.simplify}</button>
      </RunBar>
    </div>
    <section class="o-stack" data-suggestion hidden>
      <h2 id="suggestion-label">{t.suggestion}</h2>
      <div class="output" id="suggestion" role="region" aria-labelledby="suggestion-label" aria-live="polite"></div>
      <p class="meta" data-meta hidden></p>
      <div class="o-row">
        <button class="luz-btn luz-btn--primary" type="button" data-apply>{t.replace}</button>
        <button class="luz-btn luz-btn--ghost" type="button" data-undo hidden>{t.undo}</button>
      </div>
      <div class="luz-table-wrap" data-corrections hidden role="region" aria-label={k.heading} tabindex="0">
        <table class="luz-table">
          <thead><tr><th scope="col">{k.original}</th><th scope="col">{k.correction}</th><th scope="col">{k.type}</th><th scope="col">{k.why}</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../../scripts/assistant";
</script>
