---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
---

<AppLayout title="Synonym finder">
  <DemoShell slug="synonyms">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="word">Word or phrase</label>
        <input class="luz-input" id="word" required autocomplete="off" />
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="count">How many <output class="luz-output" id="count-out" for="count">6</output></label>
        <input class="luz-input" id="count" type="range" min="3" max="12" value="6" data-output="count-out" />
      </div>
      <RunBar label="Find synonyms" submit />
    </form>
    <section class="o-stack" data-results hidden>
      <h2>Synonyms</h2>
      <div class="luz-table-wrap" role="region" aria-label="Synonyms" tabindex="0">
        <table class="luz-table">
          <thead><tr><th scope="col">Word</th><th scope="col">How it differs</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <p class="meta" data-meta hidden></p>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/synonyms";
</script>
