---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
import Output from "../components/Output.astro";
---

<AppLayout title="Proofreader">
  <DemoShell slug="proofread">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="input">Text to check</label>
        <textarea class="luz-input luz-input--textarea" id="input" rows="6" required></textarea>
      </div>
      <label class="luz-toggle">
        <input class="luz-toggle__input" type="checkbox" role="switch" id="explain" checked />
        <span class="luz-toggle__track" aria-hidden="true"><span class="luz-toggle__thumb"></span></span>
        <span class="luz-toggle__label">Explain each correction</span>
      </label>
      <RunBar label="Proofread" submit />
    </form>
    <section class="o-stack" data-results hidden>
      <h2 id="marked-label">Your text, with the fixes marked</h2>
      <div class="output" id="marked" role="region" aria-labelledby="marked-label"></div>
      <p class="meta">Hover or focus a mark to read the correction.</p>
    </section>
    <Output id="out" label="Corrected text" placeholder="The corrected text appears here." />
    <section class="o-stack" data-results hidden>
      <h2>Corrections</h2>
      <div class="luz-table-wrap" role="region" aria-label="Corrections" tabindex="0">
        <table class="luz-table">
          <thead><tr><th scope="col">Original</th><th scope="col">Correction</th><th scope="col">Type</th><th scope="col">Why</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/proofread";
</script>
