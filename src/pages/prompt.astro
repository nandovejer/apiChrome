---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
import Output from "../components/Output.astro";
---

<AppLayout title="Prompt playground">
  <DemoShell slug="prompt">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="system">System prompt (optional)</label>
        <input class="luz-input" id="system" name="system" placeholder="You are a pirate." />
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="input">Prompt</label>
        <textarea class="luz-input luz-input--textarea" id="input" name="input" rows="5" required placeholder="Ask anything…"></textarea>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="example">Examples</label>
        <select class="luz-select" id="example"><option value="">Pick one…</option></select>
      </div>
      <RunBar label="Send" submit />
    </form>
    <Output id="out" label="Answer" placeholder="The answer streams here." />
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/prompt";
</script>
