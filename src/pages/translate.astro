---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
import Output from "../components/Output.astro";
import LanguageSelect from "../components/LanguageSelect.astro";
---

<AppLayout title="Universal translator">
  <DemoShell slug="translate">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="input">Text to translate</label>
        <textarea class="luz-input luz-input--textarea" id="input" name="input" rows="5" required placeholder="Write here…"></textarea>
        <div class="luz-field__helper" id="detected" aria-live="polite"></div>
      </div>
      <div class="o-grid o-grid--2">
        <LanguageSelect id="source" label="Source" value="auto" auto />
        <LanguageSelect id="target" label="Target" value="es" />
      </div>
      <RunBar label="Translate" submit>
        <button class="luz-btn luz-btn--ghost" type="button" data-swap>Swap languages</button>
      </RunBar>
    </form>
    <Output id="out" label="Translation" placeholder="Waiting for text…" />
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/translate";
</script>
