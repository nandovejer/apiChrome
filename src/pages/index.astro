---
import { LANGS, LANG_KEY, LANG_NAMES, pageHref } from "../i18n";

const targets = Object.fromEntries(LANGS.map((l) => [l, pageHref(l)]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chrome Local AI</title>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(targets[l]!, Astro.site)} />)}
    <script is:inline define:vars={{ targets, key: LANG_KEY }}>
      // The language chosen last time, else the browser's, else English.
      var saved = null;
      try {
        saved = localStorage.getItem(key);
      } catch (e) {}
      var wanted = saved || (navigator.language || "en").slice(0, 2).toLowerCase();
      location.replace(targets[wanted] || targets.en);
    </script>
  </head>
  <body>
    <main>
      <h1>Chrome Local AI</h1>
      <ul>
        {LANGS.map((l) => <li><a href={targets[l]} lang={l} hreflang={l}>{LANG_NAMES[l]}</a></li>)}
      </ul>
    </main>
  </body>
</html>
