---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
import LanguageSelect from "../components/LanguageSelect.astro";
---

<AppLayout title="Text toolkit">
  <DemoShell slug="toolkit">
    <div class="o-stack">
      <div class="luz-field">
        <label class="luz-field__label" for="text">Your text</label>
        <textarea class="luz-input luz-input--textarea" id="text" rows="8" placeholder="Paste or write a text…"></textarea>
      </div>
      <div class="o-row">
        <button class="luz-btn luz-btn--ghost" type="button" data-sample>Use a sample</button>
        <span class="meta" id="count" aria-live="polite"></span>
      </div>

      <nav class="luz-tabs" aria-label="Action">
        <a class="luz-tab" href="#panel-summarize" data-action="summarize">Summarize</a>
        <a class="luz-tab" href="#panel-translate" data-action="translate">Translate</a>
        <a class="luz-tab" href="#panel-proofread" data-action="proofread">Proofread</a>
        <a class="luz-tab" href="#panel-simplify" data-action="simplify">Simplify</a>
        <a class="luz-tab" href="#panel-rewrite" data-action="rewrite">Rewrite</a>
      </nav>
      <div class="luz-tabpanel" id="panel-summarize">
        <div class="o-grid o-grid--2">
          <div class="luz-field">
            <label class="luz-field__label" for="sum-type">Type</label>
            <select class="luz-select" id="sum-type">
              <option value="key-points">Key points</option>
              <option value="tldr">TL;DR</option>
              <option value="teaser">Teaser</option>
              <option value="headline">Headline</option>
            </select>
          </div>
          <div class="luz-field">
            <label class="luz-field__label" for="sum-length">Length</label>
            <select class="luz-select" id="sum-length">
              <option value="short">Short</option>
              <option value="medium" selected>Medium</option>
              <option value="long">Long</option>
            </select>
          </div>
        </div>
      </div>
      <div class="luz-tabpanel" id="panel-translate">
        <LanguageSelect id="tr-target" label="Translate to" value="es" />
        <p class="meta">The source language is detected for you.</p>
      </div>
      <div class="luz-tabpanel" id="panel-proofread"><p class="meta">Fixes spelling, punctuation and grammar.</p></div>
      <div class="luz-tabpanel" id="panel-simplify"><p class="meta">Rewrites the text in plain, short sentences.</p></div>
      <div class="luz-tabpanel" id="panel-rewrite">
        <div class="luz-field">
          <label class="luz-field__label" for="rw-tone">Tone</label>
          <select class="luz-select" id="rw-tone">
            <option value="more-formal">More formal</option>
            <option value="more-casual">More casual</option>
          </select>
        </div>
      </div>

      <RunBar label="Run action" />
    </div>

    <section class="o-stack">
      <div class="o-row">
        <h2>Results</h2>
        <button class="luz-btn luz-btn--ghost" type="button" data-clear>Clear</button>
      </div>
      <div id="results" class="o-stack" aria-live="polite"></div>
      <p class="meta" id="empty">Run an action: every result stays here so you can compare them.</p>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/toolkit";
</script>
