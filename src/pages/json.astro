---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
---

<AppLayout title="JSON generator">
  <DemoShell slug="json">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="description">What data do you need?</label>
        <textarea class="luz-input luz-input--textarea" id="description" rows="3" required></textarea>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="preset">Schema</label>
        <select class="luz-select" id="preset"></select>
      </div>
      <div class="luz-field">
        <label class="luz-field__label" for="schema">JSON Schema</label>
        <textarea class="luz-input luz-input--textarea" id="schema" rows="10" spellcheck="false" aria-describedby="schema-help"></textarea>
        <div class="luz-field__helper" id="schema-help">The model's answer is forced to follow this schema.</div>
      </div>
      <RunBar label="Generate" submit />
    </form>
    <section class="o-stack" data-json-panel hidden>
      <div class="o-row">
        <h2>Result</h2>
        <button class="luz-copy-btn" type="button" data-copy-from="json-out" aria-label="Copy the JSON">Copy</button>
      </div>
      <pre class="luz-code-block" data-lang="json" tabindex="0" role="region" aria-label="Generated JSON"><code id="json-out"></code></pre>
      <p class="meta" data-meta hidden></p>
    </section>
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/json";
</script>
