---
import AppLayout from "../layouts/AppLayout.astro";
import DemoShell from "../components/DemoShell.astro";
import RunBar from "../components/RunBar.astro";
import Output from "../components/Output.astro";
---

<AppLayout title="Summary of summaries">
  <DemoShell slug="summary-of-summaries">
    <form class="o-stack" data-form>
      <div class="luz-field">
        <label class="luz-field__label" for="input">Long text</label>
        <textarea class="luz-input luz-input--textarea" id="input" rows="10" required></textarea>
        <div class="luz-field__helper" id="size-info" aria-live="polite"></div>
      </div>
      <div class="o-grid o-grid--2">
        <div class="luz-field">
          <label class="luz-field__label" for="chunk">Chunk size <output class="luz-output" id="chunk-out" for="chunk">2000</output> characters</label>
          <input class="luz-input" id="chunk" type="range" min="500" max="6000" step="250" value="2000" data-output="chunk-out" />
        </div>
        <div class="luz-field">
          <label class="luz-field__label" for="type">Final summary</label>
          <select class="luz-select" id="type">
            <option value="tldr">TL;DR</option>
            <option value="key-points">Key points</option>
            <option value="teaser">Teaser</option>
          </select>
        </div>
      </div>
      <RunBar label="Summarize in chunks" submit>
        <progress class="luz-progress" id="steps" max="100" value="0" hidden aria-label="Summarizing chunks"></progress>
      </RunBar>
    </form>
    <Output id="out" label="Summary of the summaries" placeholder="The final summary appears here." />
    <details class="luz-card" data-partials hidden>
      <summary>Summary of each chunk</summary>
      <ol id="partials"></ol>
    </details>
  </DemoShell>
</AppLayout>

<script>
  import "../scripts/summary-of-summaries";
</script>
