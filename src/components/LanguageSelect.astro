---
import type { HTMLAttributes } from "astro/types";
import { LANGUAGES } from "../data/languages";
import { langOfPath, languageName, messages } from "../i18n";

interface Props extends Omit<HTMLAttributes<"select">, "id" | "value"> {
  id: string;
  label: string;
  value?: string;
  /** Adds an "Auto-detect" option first. */
  auto?: boolean;
}

const { id, label, value = "en", auto = false, ...rest } = Astro.props;
const lang = langOfPath(Astro.url.pathname);
const options = LANGUAGES.map((code) => ({ code, name: languageName(code, lang) })).sort((a, b) => a.name.localeCompare(b.name, lang));
---

<div class="luz-field">
  <label class="luz-field__label" for={id}>{label}</label>
  <select class="luz-select" id={id} name={id} {...rest}>
    {auto && <option value="auto" selected={value === "auto"}>{messages[lang].translate.auto}</option>}
    {options.map((o) => <option value={o.code} selected={o.code === value}>{o.name}</option>)}
  </select>
</div>
