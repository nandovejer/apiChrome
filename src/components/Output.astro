---
import type { HTMLAttributes } from "astro/types";
import { i18n } from "../i18n/server";

interface Props extends Omit<HTMLAttributes<"div">, "id"> {
  id: string;
  label?: string;
  placeholder?: string;
  copy?: boolean;
  /** Draws the result line (API and time); a page with one line of its own turns it off. */
  meta?: boolean;
}

const { m } = i18n(Astro.url);
const { id, label = m.common.result, placeholder = m.common.resultPlaceholder, copy = true, meta = true, class: className, ...rest } = Astro.props;
---

<div class:list={["o-stack", className]} {...rest}>
  <div class="o-row">
    <h2 id={`${id}-label`}>{label}</h2>
    {copy && <button class="luz-copy-btn" type="button" data-copy-from={id} aria-label={m.common.copyOf(label)}>{m.common.copy}</button>}
  </div>
  <div class="output" id={id} role="region" aria-labelledby={`${id}-label`} aria-live="polite" data-placeholder={placeholder}></div>
  {meta && <p class="meta" data-meta hidden></p>}
</div>
